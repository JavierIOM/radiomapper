// ─── QRZ ──────────────────────────────────────────────────────────────────────

const QRZ_CREDS_KEY = 'adif-map-qrz-creds';
let qrzSession: string | null = sessionStorage.getItem('adif-map-qrz-session');
const qrzCache = new Map<string, { grid: string | null; lat: number | null; lon: number | null; country: string | null }>();

function setQrzButtonState(state: 'disconnected' | 'resolving' | 'connected') {
  const btn = document.getElementById('qrz-btn')!;
  btn.className = 'text-xs font-mono px-3 py-1.5 rounded border transition-colors';
  if (state === 'connected') {
    btn.classList.add('border-emerald-800', 'text-emerald-400', 'hover:border-emerald-600');
    btn.textContent = 'QRZ ●';
  } else if (state === 'resolving') {
    btn.classList.add('border-amber-800', 'text-amber-400');
    btn.textContent = 'QRZ …';
  } else {
    btn.classList.add('border-[#1e2736]', 'text-slate-500', 'hover:border-slate-600', 'hover:text-slate-300');
    btn.textContent = 'QRZ';
  }
}

async function qrzAuth(username: string, password: string): Promise<string> {
  const res = await fetch(
    `https://xmldata.qrz.com/xml/current/?username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}&agent=adif-map-v0.1`
  );
  const xml = new DOMParser().parseFromString(await res.text(), 'text/xml');
  const error = xml.querySelector('Error')?.textContent;
  if (error) throw new Error(error);
  const key = xml.querySelector('Key')?.textContent;
  if (!key) throw new Error('No session key returned');
  return key;
}

async function qrzLookup(callsign: string) {
  if (!qrzSession) return null;
  if (qrzCache.has(callsign)) return qrzCache.get(callsign)!;
  try {
    const res = await fetch(
      `https://xmldata.qrz.com/xml/current/?s=${qrzSession}&callsign=${encodeURIComponent(callsign)}&agent=adif-map-v0.1`
    );
    const xml = new DOMParser().parseFromString(await res.text(), 'text/xml');
    const error = xml.querySelector('Error')?.textContent;
    if (error?.toLowerCase().includes('session')) {
      qrzSession = null;
      sessionStorage.removeItem('adif-map-qrz-session');
      setQrzButtonState('disconnected');
      return null;
    }
    const grid    = xml.querySelector('grid')?.textContent?.trim() || null;
    const latStr  = xml.querySelector('lat')?.textContent;
    const lonStr  = xml.querySelector('lon')?.textContent;
    const country = xml.querySelector('country')?.textContent?.trim() || null;
    const result = { grid, lat: latStr ? parseFloat(latStr) : null, lon: lonStr ? parseFloat(lonStr) : null, country };
    qrzCache.set(callsign, result);
    return result;
  } catch { return null; }
}

async function resolveUnmapped(records: ReturnType<typeof parseADIF>) {
  if (!qrzSession) return;
  const unmapped = records.filter(r => !r.gridsquare || r.gridsquare.length < 4);
  if (!unmapped.length) return;

  setQrzButtonState('resolving');
  let resolved = 0;

  for (const r of unmapped) {
    if (!qrzSession) break;
    const data = await qrzLookup(r.call);
    if (!data) continue;

    let pos: [number, number] | null = null;
    if (data.grid && data.grid.length >= 4) pos = gridToLatLon(data.grid);
    else if (data.lat && data.lon) pos = [data.lat, data.lon];
    if (!pos) continue;

    resolved++;
    const band = (r.band || '').toLowerCase(), mode = r.submode || r.mode || '';
    const color = bandColor(band);
    const layer = getContactLayer(band);

    L.polyline([homeLatLon, pos], { color, weight: 1, opacity: 0.2, dashArray: '4 4' }).addTo(layer);

    const rawDate = r.qso_date || '';
    const date = rawDate.length === 8 ? `${rawDate.slice(0,4)}-${rawDate.slice(4,6)}-${rawDate.slice(6,8)}` : '';
    const rawTime = r.time_on || '';
    const time = rawTime.length >= 4 ? `${rawTime.slice(0,2)}:${rawTime.slice(2,4)}Z` : '';

    hoverPopup(
      L.marker(pos, { icon: L.divIcon({ className: '', html: qrzDot(color), iconSize: [14,14], iconAnchor: [7,7] }) })
        .addTo(layer),
      popupHtml({
        call: r.call,
        grid: data.grid || (data.lat ? `${data.lat.toFixed(1)}°, ${data.lon!.toFixed(1)}°` : ''),
        band, mode, date, time,
        rstSent: r.rst_sent, rstRcvd: r.rst_rcvd, color,
        label: `via QRZ${data.country ? ' · ' + data.country : ''}`,
      }),
      r.call
    );
  }

  // Update stats counters
  const mappedEl = document.getElementById('stat-mapped')!;
  mappedEl.textContent = String(parseInt(mappedEl.textContent!) + resolved);
  const unmappedEl = document.getElementById('stat-unmapped')!;
  const remaining = parseInt(unmappedEl.textContent!) - resolved;
  if (remaining <= 0) document.getElementById('stat-unmapped-wrap')!.classList.add('hidden');
  else unmappedEl.textContent = String(remaining);

  setQrzButtonState('connected');
}

// Modal
const modal = document.getElementById('qrz-modal')!;
const showModal = () => { modal.style.display = 'flex'; document.getElementById('qrz-password')!.focus(); };
const hideModal = () => { modal.style.display = 'none'; };

document.getElementById('qrz-btn')!.addEventListener('click', showModal);
document.getElementById('qrz-modal-close')!.addEventListener('click', hideModal);
modal.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

document.getElementById('qrz-password')!.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') document.getElementById('qrz-connect-btn')!.click();
});

document.getElementById('qrz-connect-btn')!.addEventListener('click', async () => {
  const username = (document.getElementById('qrz-username') as HTMLInputElement).value.trim();
  const password = (document.getElementById('qrz-password') as HTMLInputElement).value;
  const errEl = document.getElementById('qrz-error')!;
  const btn = document.getElementById('qrz-connect-btn') as HTMLButtonElement;

  if (!username || !password) {
    errEl.textContent = 'Enter both username and password.';
    errEl.style.display = 'block';
    return;
  }
  btn.textContent = 'Connecting…'; btn.disabled = true;
  errEl.style.display = 'none';

  try {
    const key = await qrzAuth(username, password);
    qrzSession = key;
    sessionStorage.setItem('adif-map-qrz-session', key);
    localStorage.setItem(QRZ_CREDS_KEY, JSON.stringify({ username, password: btoa(password) }));
    setQrzButtonState('connected');
    hideModal();
    if (lastRecords.length) resolveUnmapped(lastRecords);
  } catch (err: any) {
    errEl.textContent = err.message || 'Connection failed.';
    errEl.style.display = 'block';
  } finally {
    btn.textContent = 'Connect'; btn.disabled = false;
  }
});

// Restore saved credentials on load
(async () => {
  if (qrzSession) {
    setQrzButtonState('connected');
    return;
  }
  const stored = localStorage.getItem(QRZ_CREDS_KEY);
  if (!stored) return;
  try {
    const { username, password } = JSON.parse(stored);
    const key = await qrzAuth(username, atob(password));
    qrzSession = key;
    sessionStorage.setItem('adif-map-qrz-session', key);
    setQrzButtonState('connected');
  } catch {
    setQrzButtonState('disconnected');
  }
})();
