    </div>
  </div>

  <!-- Header -->
  <header class="flex items-center justify-between px-4 h-12 bg-[#0d1117] border-b border-[#1e2736] shrink-0 z-10">
    <div class="flex items-center gap-3">
      <span class="font-mono font-bold text-[#f56400] text-sm tracking-wider" id="header-call">QSO MAP</span>
