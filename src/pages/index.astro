        <span><span id="stat-mapped" class="text-slate-100 font-semibold"></span> mapped</span>
        <span id="stat-unmapped-wrap" class="hidden"><span id="stat-unmapped" class="text-slate-500"></span> no grid</span>
        <span id="stat-bands-wrap" class="hidden"><span id="stat-bands" class="text-slate-400"></span></span>
