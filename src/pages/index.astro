    <div class="flex items-center gap-2">
      <button id="demo-btn"
        class="text-xs font-mono px-3 py-1.5 rounded border border-violet-800 text-violet-400 hover:border-violet-600 transition-colors">
        Demo
      </button>
      <button id="watch-btn"
        class="text-xs font-mono px-3 py-1.5 rounded border border-[#1e2736] text-slate-500 hover:border-slate-600 hover:text-slate-300 transition-colors">
        Watch
      </button>
      <button id="gl-btn"
        class="text-xs font-mono px-3 py-1.5 rounded border border-emerald-800 text-emerald-400 hover:border-emerald-600 transition-colors">
        GL
      </button>
      <button id="qrz-btn"
        class="text-xs font-mono px-3 py-1.5 rounded border border-[#1e2736] text-slate-500 hover:border-slate-600 hover:text-slate-300 transition-colors">
        QRZ
      </button>
      <label for="file-input"
        class="cursor-pointer bg-[#f56400] hover:bg-[#d94f00] text-white text-xs font-mono font-semibold px-3 py-1.5 rounded transition-colors select-none">
        Load ADIF
      </label>
      <input type="file" id="file-input" style="opacity:0;width:0;height:0;position:absolute;" />
    </div>
  </header>

  <!-- Map -->
  <div class="relative flex-1" id="map-container">
    <div id="map" class="absolute inset-0"></div>

    <!-- Welcome overlay -->
    <div id="overlay" class="absolute inset-0 flex items-center justify-center z-[1000] bg-[#080b12]/80 backdrop-blur-sm">
      <div class="text-center border border-[#1e2736] rounded-xl p-12 max-w-sm bg-[#0d1117]">
        <svg class="w-12 h-12 mx-auto mb-5 text-[#f56400]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c-.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
        </svg>
        <p class="text-slate-200 font-mono text-base font-semibold mb-2">Drop your ADIF file here</p>
        <p class="text-slate-500 text-xs font-mono">or use the Load ADIF button above</p>
        <p class="text-slate-600 text-xs font-mono mt-1">.adi / .adif — WSJT-X, Minos, any logger</p>
      </div>
    </div>

    <!-- Legend -->
    <div id="legend" class="hidden absolute bottom-6 left-4 z-[999] bg-[#0d1117]/90 backdrop-blur border border-[#1e2736] rounded-lg p-3 text-xs font-mono text-slate-300 min-w-[90px]"></div>
  </div>

</body>

<script>
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';
import SunCalc from 'suncalc';

// ─── ADIF Parser ─────────────────────────────────────────────────────────────

function parseADIF(text: string) {
  const records = [];
  const eohIdx = text.search(/<eoh>/i);
  const body = eohIdx >= 0 ? text.slice(eohIdx + 5) : text;
  for (const part of body.split(/<eor>/i)) {
    if (!part.trim()) continue;
    const record: Record<string, string> = {};
    const re = /<([^:>]+):(\d+)(?::[^>]*)?>/g;
    let m;
    while ((m = re.exec(part)) !== null) {
      const len = parseInt(m[2]);
      if (len === 0) continue;
      record[m[1].toLowerCase()] = part.slice(m.index + m[0].length, m.index + m[0].length + len).trim();
    }
    if (record.call) records.push(record);
  }
  return records;
}

// ─── Maidenhead → [lat, lon] ─────────────────────────────────────────────────

function gridToLatLon(grid: string): [number, number] | null {
  if (!grid || grid.length < 4) return null;
  const g = grid.toUpperCase();
  if (!/^[A-R][A-R][0-9][0-9]/i.test(g)) return null;
  let lon = (g.charCodeAt(0) - 65) * 20 - 180;
  let lat = (g.charCodeAt(1) - 65) * 10 - 90;
  lon += parseInt(g[2]) * 2;
  lat += parseInt(g[3]);
  if (g.length >= 6 && /[A-X][A-X]/i.test(g.slice(4, 6))) {
    lon += (g.charCodeAt(4) - 65) * (2 / 24) + (1 / 24);
    lat += (g.charCodeAt(5) - 65) * (1 / 24) + (1 / 48);
  } else {
    lon += 1; lat += 0.5;
  }
  return [lat, lon];
}

// ─── Band colours ─────────────────────────────────────────────────────────────

const BAND_COLORS: Record<string, string> = {
  '160m':'#ef4444','80m':'#f97316','60m':'#eab308','40m':'#84cc16',
  '30m':'#22c55e','20m':'#06b6d4','17m':'#3b82f6','15m':'#8b5cf6',
  '12m':'#d946ef','10m':'#f43f5e','6m':'#fb923c','4m':'#facc15',
  '2m':'#34d399','70cm':'#a78bfa','23cm':'#e879f9',
};
const BAND_ORDER = ['160m','80m','60m','40m','30m','20m','17m','15m','12m','10m','6m','4m','2m','70cm','23cm'];

function bandColor(band: string) { return BAND_COLORS[band?.toLowerCase()] || '#64748b'; }
function bandSort(a: string, b: string) { return BAND_ORDER.indexOf(a.toLowerCase()) - BAND_ORDER.indexOf(b.toLowerCase()); }

function dot(color: string, size = 8) {
  return `<div style="width:${size}px;height:${size}px;background:${color};border:1px solid rgba(255,255,255,0.35);border-radius:50%;box-shadow:0 0 4px ${color}44;"></div>`;
}
function qrzDot(color: string) {
  return `<div style="position:relative;width:14px;height:14px;">
    <div style="position:absolute;inset:0;border:1.5px dashed ${color};border-radius:50%;opacity:0.7;"></div>
    <div style="position:absolute;top:3px;left:3px;width:8px;height:8px;background:${color};border-radius:50%;opacity:0.85;box-shadow:0 0 3px ${color}66;"></div>
  </div>`;
}

// ─── Map ──────────────────────────────────────────────────────────────────────

const map = L.map('map', { center: [54.15, -4.47], zoom: 4 });
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
  subdomains: 'abcd', maxZoom: 19,
}).addTo(map);

const greylineGroup = L.layerGroup().addTo(map);
const bandLayerGroups = new Map<string, L.LayerGroup>();
const hiddenBands = new Set<string>();
let homeMarker: L.Marker | null = null;
let homeLatLon: [number, number] = [54.15, -4.47];

function getContactLayer(band: string): L.LayerGroup {
  const key = band || '__none__';
  if (!bandLayerGroups.has(key)) {
    const lg = L.layerGroup();
    if (!hiddenBands.has(key)) lg.addTo(map);
    bandLayerGroups.set(key, lg);
  }
  return bandLayerGroups.get(key)!;
}

function clearAllContacts() {
  bandLayerGroups.forEach(lg => { lg.clearLayers(); lg.remove(); });
  bandLayerGroups.clear();
  hiddenBands.clear();
}

function allBands(): string[] {
  return [...bandLayerGroups.keys()].filter(k => k !== '__none__').sort(bandSort);
}

function toggleBand(band: string) {
  const lg = bandLayerGroups.get(band);
  if (!lg) return;
  if (hiddenBands.has(band)) {
    hiddenBands.delete(band);
    lg.addTo(map);
  } else {
    hiddenBands.add(band);
    lg.remove();
  }
  renderBandFilter();
  updateLegend();
}

function setHomeMarker(latlon: [number, number], callsign: string, grid: string) {
  homeMarker?.remove();
  homeLatLon = latlon;
  const m = L.marker(latlon, {
    icon: L.divIcon({
      className: '',
      html: `<div style="width:14px;height:14px;background:#f56400;border:2px solid #fff;border-radius:50%;box-shadow:0 0 8px #f5640088;"></div>`,
      iconSize: [14, 14], iconAnchor: [7, 7],
    }),
    zIndexOffset: 1000,
  }).addTo(map);
  homeMarker = hoverPopup(m, popupHtml({ call: callsign, grid, label: 'My station', color: '#f56400' }), callsign);
}

// ─── Popup ────────────────────────────────────────────────────────────────────

function popupHtml({ call, grid, band, mode, date, time, rstSent, rstRcvd, label, color }: {
  call: string; grid?: string; band?: string; mode?: string;
  date?: string; time?: string; rstSent?: string; rstRcvd?: string;
  label?: string; color?: string;
}) {
  const rows = [];
  if (grid)    rows.push(`<div style="color:#94a3b8;">${grid}</div>`);
  if (band)    rows.push(`<div><span style="color:${color}">${band}</span>${mode ? ` · ${mode}` : ''}</div>`);
  if (date)    rows.push(`<div style="color:#94a3b8;">${date}${time ? ` ${time}` : ''}</div>`);
  if (rstRcvd) rows.push(`<div style="color:#94a3b8;">SNR ${rstRcvd} / ${rstSent}</div>`);
  if (label)   rows.push(`<div style="color:#475569;font-size:11px;margin-top:4px;">${label}</div>`);
  return `<div style="padding:10px 14px;min-width:140px;">
    <div style="font-size:14px;font-weight:700;color:#f1f5f9;margin-bottom:4px;">${call}</div>
    ${rows.join('')}
  </div>`;
}

function hoverPopup(marker: L.Marker, html: string, callsign?: string): L.Marker {
  marker.bindPopup(html, { autoPan: false });
  marker.on('mouseover', () => marker.openPopup());
  marker.on('mouseout', () => marker.closePopup());
  if (callsign) {
    marker.on('click', () => window.open(`https://www.qrz.com/db/${encodeURIComponent(callsign)}`, '_blank', 'noopener'));
  }
  return marker;
}

// ─── Render contacts ──────────────────────────────────────────────────────────

let lastRecords: ReturnType<typeof parseADIF> = [];

function renderContacts(records: ReturnType<typeof parseADIF>) {
  lastRecords = records;
  clearAllContacts();
  if (!records.length) return;

  const first = records[0];
  const myCallsign = first.station_callsign || first.operator || '2D0PEY';
  const myGrid = first.my_gridsquare || 'IO74RE';
  const myLatLon = gridToLatLon(myGrid) || [54.15, -4.47] as [number, number];

  setHomeMarker(myLatLon, myCallsign, myGrid);
  document.getElementById('header-call')!.textContent = myCallsign;

  let mapped = 0, unmapped = 0;
  const bounds = L.latLngBounds([myLatLon]);

  for (const r of records) {
    const grid = r.gridsquare;
    if (!grid || grid.length < 4) { unmapped++; continue; }
    const pos = gridToLatLon(grid);
    if (!pos) { unmapped++; continue; }

    mapped++;
    const band = (r.band || '').toLowerCase(), mode = r.submode || r.mode || '';
    const color = bandColor(band);
    const layer = getContactLayer(band);
    bounds.extend(pos);

    const line = L.polyline([myLatLon, pos], { color, weight: 1, opacity: 0.35 }).addTo(layer);
    animateBeam(line);

    const rawDate = r.qso_date || '';
    const date = rawDate.length === 8 ? `${rawDate.slice(0,4)}-${rawDate.slice(4,6)}-${rawDate.slice(6,8)}` : '';
    const rawTime = r.time_on || '';
    const time = rawTime.length >= 4 ? `${rawTime.slice(0,2)}:${rawTime.slice(2,4)}Z` : '';

    hoverPopup(
      L.marker(pos, { icon: L.divIcon({ className: '', html: dot(color, 8), iconSize: [8,8], iconAnchor: [4,4] }) })
        .addTo(layer),
      popupHtml({ call: r.call, grid, band, mode, date, time, rstSent: r.rst_sent, rstRcvd: r.rst_rcvd, color }),
      r.call
    );
  }

  document.getElementById('stat-total')!.textContent = String(records.length);
  document.getElementById('stat-mapped')!.textContent = String(mapped);

  const unmappedWrap = document.getElementById('stat-unmapped-wrap')!;
  if (unmapped > 0) {
    document.getElementById('stat-unmapped')!.textContent = String(unmapped);
    unmappedWrap.classList.remove('hidden');
  } else {
    unmappedWrap.classList.add('hidden');
  }

  document.getElementById('stats-bar')!.style.display = 'flex';
  document.getElementById('overlay')!.style.display = 'none';
  renderBandFilter();
  updateLegend();
  if (mapped > 0) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 8 });

  // Auto-resolve unmapped contacts if QRZ is connected
  if (unmapped > 0 && qrzSession) resolveUnmapped(records);
}

// ─── Band filter + legend ─────────────────────────────────────────────────────

function renderBandFilter() {
  const bands = allBands();
  const wrap = document.getElementById('stat-bands-wrap')!;
  const el = document.getElementById('stat-bands')!;
  if (!bands.length) { wrap.classList.add('hidden'); return; }
  el.innerHTML = bands.map(band => {
    const off = hiddenBands.has(band);
    const color = off ? '#475569' : bandColor(band);
    return `<span data-band="${band}" style="cursor:pointer;color:${color};${off ? 'opacity:0.45;text-decoration:line-through;' : ''}">${band}</span>`;
  }).join('<span style="color:#334155"> · </span>');
  wrap.classList.remove('hidden');
}

function updateLegend() {
  const el = document.getElementById('legend')!;
  const bands = allBands();
  if (!bands.length) { el.classList.add('hidden'); return; }
  el.innerHTML = bands.map(band => {
    const off = hiddenBands.has(band);
    const color = off ? '#475569' : bandColor(band);
    return `<div data-band="${band}" style="display:flex;align-items:center;gap:7px;margin-bottom:4px;cursor:pointer;opacity:${off ? 0.4 : 1};">
      ${dot(color, 10)}<span style="${off ? 'text-decoration:line-through;' : ''}">${band}</span>
    </div>`;
  }).join('');
  el.classList.remove('hidden');
}

document.getElementById('stat-bands')!.addEventListener('click', (e) => {
  const span = (e.target as HTMLElement).closest<HTMLElement>('[data-band]');
  if (span?.dataset.band) toggleBand(span.dataset.band);
});

document.getElementById('legend')!.addEventListener('click', (e) => {
  const div = (e.target as HTMLElement).closest<HTMLElement>('[data-band]');
  if (div?.dataset.band) toggleBand(div.dataset.band);
});

// ─── File loading ─────────────────────────────────────────────────────────────

function loadFile(file: File) {
  if (demoRunning) {
    demoStop = true;
    demoRunning = false;
    const btn = document.getElementById('demo-btn')!;
    btn.textContent = 'Demo';
    btn.className = 'text-xs font-mono px-3 py-1.5 rounded border border-violet-800 text-violet-400 hover:border-violet-600 transition-colors';
  }
  const reader = new FileReader();
  reader.onload = (e) => renderContacts(parseADIF(e.target!.result as string));
  reader.readAsText(file);
}

document.getElementById('file-input')!.addEventListener('change', (e) => {
  const file = (e.target as HTMLInputElement).files?.[0];
  if (file) loadFile(file);
  (e.target as HTMLInputElement).value = '';
});

document.addEventListener('dragover', (e) => { e.preventDefault(); e.stopPropagation(); document.body.classList.add('dragging'); }, true);
document.addEventListener('dragleave', (e) => { if (!e.relatedTarget) document.body.classList.remove('dragging'); }, true);
document.addEventListener('drop', (e) => {
  e.preventDefault(); e.stopPropagation();
  document.body.classList.remove('dragging');
  const file = (e as DragEvent).dataTransfer?.files?.[0];
  if (file) loadFile(file);
}, true);

// ─── Live contact animations ──────────────────────────────────────────────────

function animateBeam(line: L.Polyline) {
  // SVG stroke-dashoffset trick: draw the line from home → contact over 900ms
  requestAnimationFrame(() => {
    const path = (line as any)._path as SVGPathElement | undefined;
    if (!path) return;
    const len = path.getTotalLength();
    path.style.strokeDasharray = `${len}`;
    path.style.strokeDashoffset = `${len}`;
    path.style.transition = 'stroke-dashoffset 0.9s ease-in-out';
    requestAnimationFrame(() => { path.style.strokeDashoffset = '0'; });
  });
}

function rippleDot(color: string) {
  return `<div style="position:relative;width:24px;height:24px;">
    <div style="position:absolute;inset:0;border-radius:50%;background:${color};animation:ripple-out 1.4s ease-out forwards;"></div>
    <div style="position:absolute;inset:0;border-radius:50%;background:${color};animation:ripple-out 1.4s 0.2s ease-out forwards;"></div>
    <div style="position:absolute;top:8px;left:8px;width:8px;height:8px;border-radius:50%;background:${color};box-shadow:0 0 8px ${color};"></div>
  </div>`;
}

function addLiveContacts(records: ReturnType<typeof parseADIF>) {
  for (const r of records) {
    const band = (r.band || '').toLowerCase(), mode = r.submode || r.mode || '';
    const color = bandColor(band);
    const layer = getContactLayer(band);
    const rawDate = r.qso_date || '';
    const date = rawDate.length === 8 ? `${rawDate.slice(0,4)}-${rawDate.slice(4,6)}-${rawDate.slice(6,8)}` : '';
    const rawTime = r.time_on || '';
    const time = rawTime.length >= 4 ? `${rawTime.slice(0,2)}:${rawTime.slice(2,4)}Z` : '';

    const plotContact = (pos: [number, number], label?: string) => {
      const line = L.polyline([homeLatLon, pos], { color, weight: 2, opacity: 0.8 }).addTo(layer);
      animateBeam(line);
      setTimeout(() => { (line as any).setStyle({ weight: 1, opacity: 0.35 }); }, 1000);

      const marker = hoverPopup(
        L.marker(pos, {
          icon: L.divIcon({ className: '', html: rippleDot(color), iconSize: [24, 24], iconAnchor: [12, 12] }),
        }).addTo(layer),
        popupHtml({ call: r.call, grid: r.gridsquare, band, mode, date, time, rstSent: r.rst_sent, rstRcvd: r.rst_rcvd, color, label }),
        r.call
      );

      setTimeout(() => {
        marker.setIcon(L.divIcon({ className: '', html: dot(color, 8), iconSize: [8, 8], iconAnchor: [4, 4] }));
      }, 1500);

      const mappedEl = document.getElementById('stat-mapped')!;
      mappedEl.textContent = String(parseInt(mappedEl.textContent || '0') + 1);
      renderBandFilter();
      updateLegend();
    };

    const grid = r.gridsquare;
    let pos: [number, number] | null = grid && grid.length >= 4 ? gridToLatLon(grid) : null;

    if (pos) {
      plotContact(pos);
    } else if (qrzCache.has(r.call)) {
      const cached = qrzCache.get(r.call)!;
      if (cached.grid) pos = gridToLatLon(cached.grid);
      else if (cached.lat && cached.lon) pos = [cached.lat, cached.lon];
      if (pos) plotContact(pos, `via QRZ${cached.country ? ' · ' + cached.country : ''}`);
    } else if (qrzSession) {
      qrzLookup(r.call).then(data => {
        if (!data) return;
        let p: [number, number] | null = null;
        if (data.grid) p = gridToLatLon(data.grid);
        else if (data.lat && data.lon) p = [data.lat, data.lon];
        if (p) plotContact(p, `via QRZ${data.country ? ' · ' + data.country : ''}`);
      });
    }
  }
}

// ─── Live file watch ─────────────────────────────────────────────────────────

const POLL_MS = 15_000;
let watchHandle: any = null;
let watchTimer: ReturnType<typeof setInterval> | null = null;
let lastFileText = '';

function setWatchBtn(state: 'off' | 'live') {
  const btn = document.getElementById('watch-btn')!;
  if (state === 'live') {
    btn.className = 'text-xs font-mono px-3 py-1.5 rounded border border-rose-700 text-rose-400 transition-colors';
    btn.innerHTML = '<span class="live-pulse">●</span>&nbsp;Live';
  } else {
    btn.className = 'text-xs font-mono px-3 py-1.5 rounded border border-[#1e2736] text-slate-500 hover:border-slate-600 hover:text-slate-300 transition-colors';
    btn.textContent = 'Watch';
  }
}

async function pollFile() {
  if (!watchHandle) return;
  try {
    const file = await watchHandle.getFile();
    const text = await file.text();
    if (text !== lastFileText) {
      lastFileText = text;
      renderContacts(parseADIF(text));
    }
  } catch {
    stopWatch();
  }
}

function stopWatch() {
  if (watchTimer) { clearInterval(watchTimer); watchTimer = null; }
  watchHandle = null;
  lastFileText = '';
  setWatchBtn('off');
}

document.getElementById('watch-btn')!.addEventListener('click', async () => {
  if (watchHandle) { stopWatch(); return; }

  if (!('showOpenFilePicker' in window)) {
    alert('Live watch requires Chrome or Edge.');
    return;
  }

  try {
    const [handle] = await (window as any).showOpenFilePicker({
      types: [{ description: 'ADIF log', accept: { 'text/plain': ['.adi', '.adif'] } }],
      multiple: false,
    });
    watchHandle = handle;
    setWatchBtn('live');
    await pollFile();
    watchTimer = setInterval(pollFile, POLL_MS);
  } catch {
    // user cancelled picker — do nothing
  }
});

// ─── Grey line / solar terminator ────────────────────────────────────────────

function getSubsolarPoint(date: Date): [number, number] {
  // Scan equator for max sun altitude → subsolar longitude
  let subLon = 0, maxAlt = -Infinity;
  for (let lon = -180; lon <= 180; lon += 2) {
    const alt = SunCalc.getPosition(date, 0, lon).altitude;
    if (alt > maxAlt) { maxAlt = alt; subLon = lon; }
  }
  // Fine-tune to 0.2° resolution
  for (let lon = subLon - 2; lon <= subLon + 2; lon += 0.2) {
    const alt = SunCalc.getPosition(date, 0, lon).altitude;
    if (alt > maxAlt) { maxAlt = alt; subLon = lon; }
  }
  // Scan latitudes at subsolar lon → declination
  let subLat = 0; maxAlt = -Infinity;
  for (let lat = -30; lat <= 30; lat += 0.5) {
    const alt = SunCalc.getPosition(date, lat, subLon).altitude;
    if (alt > maxAlt) { maxAlt = alt; subLat = lat; }
  }
  return [subLat, subLon];
}

function normLon(lon: number, ref: number): number {
  while (lon > ref + 180) lon -= 360;
  while (lon < ref - 180) lon += 360;
  return lon;
}

let glVisible = true;

function drawGreyline() {
  greylineGroup.clearLayers();
  if (!glVisible) return;

  const [subLat, subLon] = getSubsolarPoint(new Date());
  const δ = subLat * Math.PI / 180;
  // Anti-subsolar point (centre of night side) — use as reference for longitude normalization
  const nightLon = subLon > 0 ? subLon - 180 : subLon + 180;

  const dawnArm: [number, number][] = [];
  const duskArm: [number, number][] = [];

  for (let lat = -89; lat <= 89; lat++) {
    const φ = lat * Math.PI / 180;
    const cosH = -Math.tan(φ) * Math.tan(δ);
    if (Math.abs(cosH) > 1) continue; // polar day or polar night — no terminator here
    const H = Math.acos(cosH) * 180 / Math.PI;
    dawnArm.push([lat, normLon(subLon - H, nightLon)]);
    duskArm.unshift([lat, normLon(subLon + H, nightLon)]); // unshift → N-to-S order
  }

  // Night polygon: dawn arm (S→N) + dusk arm (N→S) + south pole cap for polar night.
  // No north cap — arms converge naturally at the polar-day boundary; adding one creates a spike.
  const nightPoly: [number, number][] = [
    ...dawnArm,
    ...duskArm,
    [-89.9, nightLon],
  ];

  if (nightPoly.length > 4) {
    L.polygon(nightPoly, {
      color: 'transparent',
      fillColor: '#000d2e',
      fillOpacity: 0.45,
      stroke: false,
    }).addTo(greylineGroup);
  }

}

drawGreyline();
setInterval(drawGreyline, 60_000);

document.getElementById('gl-btn')!.addEventListener('click', () => {
  glVisible = !glVisible;
  const btn = document.getElementById('gl-btn')!;
  if (glVisible) {
    btn.className = 'text-xs font-mono px-3 py-1.5 rounded border border-emerald-800 text-emerald-400 hover:border-emerald-600 transition-colors';
  } else {
    btn.className = 'text-xs font-mono px-3 py-1.5 rounded border border-[#1e2736] text-slate-500 hover:border-slate-600 hover:text-slate-300 transition-colors';
  }
  drawGreyline();
});

